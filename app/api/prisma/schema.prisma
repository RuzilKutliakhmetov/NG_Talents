generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  CANDIDATE
  EMPLOYER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum EmploymentType {
  SHIFT
  PERMANENT
  PROJECT
  PART_TIME
  TEMPORARY
}

enum WorkFormat {
  ONSITE
  HYBRID
  REMOTE
}

enum VacancyRegion {
  BASHKORTOSTAN
  KHMAO
  YANAO
  TATARSTAN
  OTHER
}

enum VacancyStatus {
  DRAFT
  PENDING_MODERATION
  MODERATION
  PUBLISHED
  PAUSED
  CLOSED
  REJECTED
  ARCHIVED
}

enum VacancyModerationAction {
  START_MODERATION
  APPROVE
  REJECT
  RESUBMIT
}

enum VerificationStatus {
  NOT_VERIFIED
  PENDING
  VERIFIED
  REQUIRES_ATTENTION
  REJECTED
}

enum ApplicationStatus {
  NEW
  VIEWED
  IN_REVIEW
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum DocumentType {
  RESUME
  CERTIFICATE
  LICENSE
  ID_CARD
  DIPLOMA
  OTHER
}

enum NotificationType {
  NEW_APPLICATION
  APPLICATION_STATUS_CHANGED
  VACANCY_PUBLISHED
  VACANCY_REJECTED
  EMPLOYER_VERIFIED
  SYSTEM
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum MembershipRole {
  OWNER
  HR
  RECRUITER
  MANAGER
}

enum EmployerMemberRole {
  OWNER
  ADMIN
  HR
  RECRUITER
}

enum CandidateCertificationType {
  A1
  B1_1
  ELECTRICAL_SAFETY
  NAKS
  OTHER
}

enum EmployerVerificationStatus {
  NOT_VERIFIED
  PENDING
  VERIFIED
  REQUIRES_ATTENTION
  REJECTED
}

enum EmployerVerificationMethod {
  MANUAL
  DADATA
  MIXED
}

enum RequirementType {
  EXPERIENCE
  EDUCATION
  CERTIFICATE
  LICENSE
  SAFETY
  SKILL
  OTHER
}

// ============================================================
// USER
// ============================================================

model User {
  id String @id @default(uuid())

  email String  @unique
  phone String? @unique

  passwordHash String

  firstName  String?
  lastName   String?
  middleName String?

  role   UserRole   @default(CANDIDATE)
  status UserStatus @default(ACTIVE)

  telegramId       String? @unique
  telegramUsername String?

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions Session[]

  candidateProfile CandidateProfile?

  employerMemberships EmployerMember[]

  applications Application[] @relation("CandidateApplications")

  applicationStatusHistory ApplicationStatusHistory[] @relation("ApplicationStatusHistoryActor")

  notifications Notification[]

  notificationPreferences NotificationPreference[]

  subscriptions Subscription[]

  auditLogs AuditLog[] @relation("AuditActor")

  resumes Resume[]

  documents CandidateDocument[]

  favorites FavoriteVacancy[]

  vacanciesCreated Vacancy[] @relation("VacancyCreatedBy")

  vacanciesUpdated Vacancy[] @relation("VacancyUpdatedBy")

  vacancyModerationAudits VacancyModerationAudit[] @relation("VacancyModerationAuditActor")

  employerVerificationsVerified EmployerVerification[] @relation("VerificationVerifiedBy")

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

// ============================================================
// SESSION
// ============================================================

model Session {
  id String @id @default(uuid())

  userId String

  refreshTokenHash String

  userAgent String?
  ipAddress String?

  expiresAt  DateTime
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================
// CANDIDATE PROFILE
// ============================================================

model CandidateProfile {
  id String @id @default(uuid())

  userId String @unique

  birthDate DateTime?

  citizenship String?

  city   String?
  region String?

  desiredPosition String?

  desiredSalaryMin Int?
  desiredSalaryMax Int?

  readyForShift     Boolean @default(false)
  readyForShiftWork Boolean @default(false)

  shiftSchedule String?

  about String?

  experienceYears Int?

  education String?

  isPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumes Resume[]

  documents CandidateDocument[]

  experiences    CandidateExperience[]
  educations     CandidateEducation[]
  certifications CandidateCertification[]

  @@index([city])
  @@index([region])
  @@index([desiredPosition])
  @@index([readyForShift])
  @@map("candidate_profiles")
}

// ============================================================
// EMPLOYER
// ============================================================

model Employer {
  id String @id @default(uuid())

  inn String @unique

  legalName String
  shortName String?

  ogrn String?
  kpp  String?

  legalAddress String?

  email   String?
  phone   String?
  address String?

  website String?

  description String?

  logoStorageKey String?

  verificationStatus VerificationStatus @default(NOT_VERIFIED)

  verifiedAt   DateTime?
  verifiedById String?

  dadataData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members EmployerMember[]

  vacancies Vacancy[]

  verifications EmployerVerification[]

  @@index([legalName])
  @@index([shortName])
  @@index([verificationStatus])
  @@map("employers")
}

// ============================================================
// EMPLOYER MEMBERS
// ============================================================

model EmployerMember {
  id String @id @default(uuid())

  employerId String
  userId     String

  role       MembershipRole     @default(HR)
  memberRole EmployerMemberRole @default(HR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employer Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([employerId, userId])
  @@index([employerId])
  @@index([userId])
  @@map("employer_members")
}

// ============================================================
// EMPLOYER VERIFICATION
// ============================================================

model EmployerVerification {
  id String @id @default(uuid())

  employerId String

  status VerificationStatus

  verificationStatus EmployerVerificationStatus @default(PENDING)

  method String?

  verificationMethod EmployerVerificationMethod @default(MANUAL)

  comment String?

  verifiedById String?

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  verifiedBy User?    @relation("VerificationVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([employerId])
  @@index([status])
  @@index([createdAt])
  @@map("employer_verifications")
}

model CandidateExperience {
  id                 String           @id @default(uuid())
  candidateProfileId String
  companyName        String
  position           String
  startDate          DateTime
  endDate            DateTime?
  isCurrent          Boolean          @default(false)
  description        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
  @@map("candidate_experiences")
}

model CandidateEducation {
  id                 String           @id @default(uuid())
  candidateProfileId String
  institution        String
  specialization     String
  degree             String?
  startYear          Int?
  endYear            Int?
  description        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
  @@map("candidate_educations")
}

model CandidateCertification {
  id                 String                     @id @default(uuid())
  candidateProfileId String
  type               CandidateCertificationType
  name               String
  number             String?
  issuedAt           DateTime?
  expiresAt          DateTime?
  issuer             String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  candidateProfile   CandidateProfile           @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
  @@index([type])
  @@index([expiresAt])
  @@map("candidate_certifications")
}

// ============================================================
// VACANCY
// ============================================================

model Vacancy {
  id String @id @default(uuid())

  employerId String

  createdById String
  updatedById String?

  title String

  slug String? @unique

  description String

  responsibilities String?

  requirementsText String?

  conditions String?

  salaryMin Int?
  salaryMax Int?

  currency    String   @default("RUB")
  salaryGross Boolean?

  employmentType EmploymentType
  workFormat     WorkFormat     @default(ONSITE)

  locationRegion  VacancyRegion
  locationCity    String?
  locationAddress String?

  schedule String?

  housingProvided  Boolean @default(false)
  flightProvided   Boolean @default(false)
  travelProvided   Boolean @default(false)
  medicalInsurance Boolean @default(false)

  status VacancyStatus @default(DRAFT)

  moderationComment String?

  publishedAt DateTime?
  closedAt    DateTime?
  expiresAt   DateTime?

  viewsCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employer Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  createdBy User @relation("VacancyCreatedBy", fields: [createdById], references: [id])

  updatedBy User? @relation("VacancyUpdatedBy", fields: [updatedById], references: [id])

  requirements     VacancyRequirement[]
  certifications   VacancyCertification[]
  moderationAudits VacancyModerationAudit[]

  applications Application[]

  favorites FavoriteVacancy[]

  @@index([employerId])
  @@index([status])
  @@index([locationRegion])
  @@index([locationCity])
  @@index([employmentType])
  @@index([salaryMin])
  @@index([salaryMax])
  @@index([publishedAt])
  @@index([createdAt])
  @@map("vacancies")
}

// ============================================================
// VACANCY REQUIREMENTS
// ============================================================

model VacancyRequirement {
  id String @id @default(uuid())

  vacancyId String

  type RequirementType

  name String

  description String?

  required  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([vacancyId])
  @@index([type])
  @@index([required])
  @@map("vacancy_requirements")
}

model VacancyCertification {
  id String @id @default(uuid())

  vacancyId String
  type      CandidateCertificationType
  name      String?
  required  Boolean                    @default(true)

  createdAt DateTime @default(now())

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([vacancyId])
  @@index([type])
  @@map("vacancy_certifications")
}

model VacancyModerationAudit {
  id String @id @default(cuid())

  vacancyId String
  vacancy   Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  actorId   String
  actor     User     @relation("VacancyModerationAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorRole UserRole

  action     VacancyModerationAction
  fromStatus VacancyStatus?
  toStatus   VacancyStatus?
  comment    String?
  createdAt  DateTime                @default(now())

  @@index([vacancyId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("vacancy_moderation_audits")
}

// ============================================================
// APPLICATION
// ============================================================

model Application {
  id String @id @default(uuid())

  vacancyId String
  vacancy   Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Restrict)

  candidateId String
  candidate   User   @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: Restrict)

  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  status ApplicationStatus @default(NEW)

  coverLetter String?

  candidateComment String?
  employerComment  String?

  appliedAt DateTime  @default(now())
  viewedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  statusHistory ApplicationStatusHistory[]

  @@unique([vacancyId, candidateId])
  @@index([candidateId, createdAt])
  @@index([vacancyId, status])
  @@index([status, appliedAt])
  @@map("applications")
}

model ApplicationStatusHistory {
  id String @id @default(uuid())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation("ApplicationStatusHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  actorRole UserRole

  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus

  comment String?

  createdAt DateTime @default(now())

  @@index([applicationId, createdAt])
  @@index([actorId, createdAt])
  @@index([toStatus, createdAt])
  @@map("application_status_history")
}

// ============================================================
// RESUME
// ============================================================

model Resume {
  id String @id @default(uuid())

  userId String

  candidateProfileId String

  title String

  storageKey String

  originalName String

  mimeType String

  sizeBytes Int

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  applications Application[]

  @@index([userId])
  @@index([candidateProfileId])
  @@index([isPrimary])
  @@map("resumes")
}

// ============================================================
// CANDIDATE DOCUMENT
// ============================================================

model CandidateDocument {
  id String @id @default(uuid())

  userId String

  candidateProfileId String

  type DocumentType

  title String

  storageKey String

  originalName String

  mimeType String

  sizeBytes Int

  issuedAt DateTime?

  expiresAt DateTime?

  verificationStatus VerificationStatus @default(NOT_VERIFIED)

  verificationComment String?

  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([candidateProfileId])
  @@index([type])
  @@index([verificationStatus])
  @@index([expiresAt])
  @@map("candidate_documents")
}

// ============================================================
// FAVORITE VACANCIES
// ============================================================

model FavoriteVacancy {
  id String @id @default(uuid())

  userId    String
  vacancyId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@unique([userId, vacancyId])
  @@index([userId])
  @@index([vacancyId])
  @@map("favorite_vacancies")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id String @id @default(uuid())

  userId String

  type NotificationType

  channel NotificationChannel

  status NotificationStatus @default(PENDING)

  title String

  message String

  data Json?

  sentAt DateTime?

  error String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// NOTIFICATION PREFERENCES
// ============================================================

model NotificationPreference {
  id String @id @default(uuid())

  userId String

  type NotificationType

  channel NotificationChannel

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@index([userId])
  @@map("notification_preferences")
}

// ============================================================
// SUBSCRIPTIONS
// ============================================================

model Subscription {
  id String @id @default(uuid())

  userId String

  name String?

  filters Json

  enabled Boolean @default(true)

  lastSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
  @@map("subscriptions")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id String @id @default(uuid())

  actorId String?

  action String

  entityType String

  entityId String?

  oldData Json?

  newData Json?

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
